# AgentLoom application settings
AGENTLOOM_ENV=development
AGENTLOOM_LOG_LEVEL=INFO
AGENTLOOM_DATABASE_URL=postgresql+asyncpg://agentloom:agentloom@localhost:15432/agentloom
AGENTLOOM_LLM_PROVIDER=mock
AGENTLOOM_LLM_MODEL=mock/schema
AGENTLOOM_LLM_TIMEOUT_SECONDS=60
AGENTLOOM_WORKER_MAX_TURNS=6

# PostgreSQL development settings
POSTGRES_DB=agentloom
POSTGRES_USER=agentloom
POSTGRES_PASSWORD=agentloom
POSTGRES_PORT=15432

